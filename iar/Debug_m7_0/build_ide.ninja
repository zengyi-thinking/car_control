##IAR Ninja build file


#Rules
rule ASSEMBLER
  command = "D$:\software\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\bin\iasmarm.exe" --IDE3 -f "$rspfile_name" -y "$depfile_name"
  depfile = $depfile_name
  deps = gcc
  description = IAR_NEW_TOOL+++ASSEMBLER+++$in
  rspfile = $rspfile_name
  rspfile_content = $flags

rule COMPILER
  command = "D$:\software\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\bin\iccarm.exe" --IDE3 -f "$rspfile_name" --dependencies=n "$depfile_name"
  depfile = $depfile_name
  deps = gcc
  description = IAR_NEW_TOOL+++COMPILER+++$in
  rspfile = $rspfile_name
  rspfile_content = $flags

rule LINKER
  command = "D$:\software\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\bin\ilinkarm.exe" --IDE3 -f "$rspfile_name" --dependencies=n "$depfile_name"
  depfile = $depfile_name
  deps = gcc
  description = IAR_NEW_TOOL+++LINKER+++$out
  rspfile = $rspfile_name
  rspfile_content = $flags

rule OBJCOPY
  command = "D$:\software\IAR$ Systems\Embedded$ Workbench$ 9.2\arm\bin\ielftool.exe" $flags
  description = IAR_NEW_TOOL+++OBJCOPY+++$out

rule ZEROCHECK
  command = "D$:\software\IAR$ Systems\Embedded$ Workbench$ 9.2\common\bin\iarbuild.exe" $flags
  description = IAR_NEW_TOOL+++ZEROCHECK+++$out
  generator = 1



